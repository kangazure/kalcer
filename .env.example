APP_NAME="PT Jaringan Teknologi Sejahtera"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://rikoardianto.web.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_LEVEL=warning

# =================================================================
# DATABASE — Supabase PostgreSQL
# Project: ambil dari Supabase Dashboard > Project Settings > Database
# Gunakan "Connection Pooling" (port 6543, mode transaction) untuk app
# runtime, dan "Direct Connection" (port 5432) khusus untuk migration.
# =================================================================
DB_CONNECTION=pgsql
DB_HOST=db.xxxxxxxxxxxxxxxxxxxx.supabase.co
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=public
DB_SSLMODE=require

DB_DIRECT_HOST=db.xxxxxxxxxxxxxxxxxxxx.supabase.co
DB_DIRECT_PORT=5432

# =================================================================
# SUPABASE — API Layer (Auth, Storage, Realtime, Edge Functions)
# =================================================================
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET_MEDIA=media
SUPABASE_STORAGE_BUCKET_GALLERY=gallery
SUPABASE_STORAGE_BUCKET_DOCUMENTS=documents
SUPABASE_STORAGE_BUCKET_AVATARS=avatars
SUPABASE_REALTIME_ENABLED=true

# =================================================================
# CACHE / SESSION / QUEUE — Redis
# =================================================================
CACHE_STORE=redis
CACHE_PREFIX=jts_cache_
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

QUEUE_CONNECTION=redis
HORIZON_DOMAIN=
HORIZON_PATH=horizon

BROADCAST_CONNECTION=redis

# =================================================================
# JWT AUTHENTICATION (API)
# =================================================================
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256

SANCTUM_STATEFUL_DOMAINS=rikoardianto.web.id,www.rikoardianto.web.id
SANCTUM_GUARD=web

# =================================================================
# MAIL (SMTP)
# =================================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.zoho.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@ptjts.id
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@ptjts.id
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ADMIN_NOTIFICATION=admin@ptjts.id

# =================================================================
# INTEGRASI — WhatsApp Business API
# =================================================================
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ADMIN_NUMBER=6282183999981

# =================================================================
# INTEGRASI — Telegram Bot (notifikasi internal: lead, gangguan, lamaran)
# =================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# =================================================================
# INTEGRASI — Google Maps (coverage area, cek jangkauan)
# =================================================================
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_DEFAULT_LAT=-5.0667
GOOGLE_MAPS_DEFAULT_LNG=105.5333

# =================================================================
# INTEGRASI — Firebase Cloud Messaging (push notification admin)
# =================================================================
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=storage/app/firebase/service-account.json
FCM_SERVER_KEY=

# =================================================================
# SECURITY — Captcha / Bot Protection
# =================================================================
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_VERSION=v3
RECAPTCHA_SCORE_THRESHOLD=0.5

# =================================================================
# RATE LIMITING
# =================================================================
THROTTLE_API_PER_MINUTE=60
THROTTLE_LOGIN_PER_MINUTE=5
THROTTLE_CONTACT_PER_MINUTE=3
THROTTLE_COMMENT_PER_MINUTE=5

# =================================================================
# SEO / ANALYTICS
# =================================================================
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
GOOGLE_SEARCH_CONSOLE_VERIFICATION=
GOOGLE_TAG_MANAGER_ID=
SITE_DEFAULT_OG_IMAGE=/images/og/default-og.jpg

# =================================================================
# NETWORK MONITORING (SNMP / API endpoint perangkat NOC)
# =================================================================
NETWORK_MONITOR_API_URL=
NETWORK_MONITOR_API_KEY=
NETWORK_MONITOR_POLL_INTERVAL=60
SPEEDTEST_SERVER_URL=

# =================================================================
# BACKUP
# =================================================================
BACKUP_ARCHIVE_PASSWORD=
BACKUP_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
VITE_GOOGLE_MAPS_API_KEY="${GOOGLE_MAPS_API_KEY}"
VITE_TURNSTILE_SITE_KEY="${CLOUDFLARE_TURNSTILE_SITE_KEY}"
