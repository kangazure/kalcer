{
    "name": "ptjts-website",
    "version": "1.0.0",
    "private": true,
    "description": "PT Jaringan Teknologi Sejahtera - Frontend Build Pipeline",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build && vite build --ssrManifest",
        "build:production": "vite build --mode production",
        "preview": "vite preview",
        "lint": "eslint resources/js --ext .ts,.js",
        "format": "prettier --write \"resources/**/*.{ts,js,css,scss}\"",
        "type-check": "tsc --noEmit"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.9",
        "@tailwindcss/typography": "^0.5.15",
        "@types/alpinejs": "^3.13.10",
        "@types/three": "^0.171.0",
        "autoprefixer": "^10.4.20",
        "concurrently": "^9.1.0",
        "laravel-vite-plugin": "^1.1.1",
        "postcss": "^8.4.49",
        "postcss-nesting": "^13.0.1",
        "sass": "^1.83.0",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.7.2",
        "vite": "^6.0.5",
        "vite-plugin-compression2": "^1.3.3",
        "vite-plugin-image-optimizer": "^1.1.8",
        "vite-tsconfig-paths": "^5.1.4"
    },
    "dependencies": {
        "alpinejs": "^3.14.6",
        "@alpinejs/collapse": "^3.14.6",
        "@alpinejs/intersect": "^3.14.6",
        "@alpinejs/persist": "^3.14.6",
        "gsap": "^3.12.5",
        "aos": "^2.3.4",
        "three": "^0.171.0",
        "lenis": "^1.1.18",
        "swiper": "^11.1.15",
        "lottie-web": "^5.12.2",
        "chart.js": "^4.4.7",
        "axios": "^1.7.9",
        "nprogress": "^0.2.0"
    }
}
